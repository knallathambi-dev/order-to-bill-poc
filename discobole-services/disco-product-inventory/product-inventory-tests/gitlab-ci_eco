# ECO / Energy Estimation

estimate_energy:
  stage: eco
  image: python:3.10
  script:
    - pip install requests python-dateutil py-cpuinfo psutil urllib3 beautifulsoup4
    - pip install psycopg2-binary
    - python mesure.py
  when: always
  artifacts:
    paths:
      - output/


# Others

reuse:
  image:
    name: fsfe/reuse:latest
    entrypoint: []
  stage: .pre
  script:
    - reuse lint
    - if [ 0 != 0 ]; then log_error Fix the error with reuse annotate --copyright=\"Orange SA\" --template mit.jinja --license MIT --copyright-prefix spdx --skip-unrecognised --merge-copyrights --recursive ./; fi




