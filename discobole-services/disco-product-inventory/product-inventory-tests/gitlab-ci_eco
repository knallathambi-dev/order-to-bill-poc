# ==================================================
# Include pipeline templates
# ==================================================

include:
  # Gitleaks template
  #- remote: 'https://gitlab.com/to-be-continuous/gitleaks/-/raw/2.6.0/templates/gitlab-ci-gitleaks.yml'
  # semantic-release template
  - remote: 'https://gitlab.com/to-be-continuous/semantic-release/-/raw/3.11.3/templates/gitlab-ci-semrel.yml'

# ==================================================
# Pipelie variables
# ==================================================

# variables:
  # Gitleaks template parameters
#  GITLEAKS_IMAGE: "registry.hub.docker.com/zricethezav/gitleaks:v8.15.0"

# ==================================================
# Stages
# ==================================================

stages:
  - test
  - trigger-fe
  - System
  - Job
  - JobSpecification
  - Product
  - Reporting
  - publish
  - eco

# ==================================================
# Pipeline jobs
# ==================================================

.default_robot_job: &robot_job
  image: ppodgorsek/robot-framework:latest
  script:
    - robot $option $directory || true
  artifacts:
    expire_in: 72h
    paths:
      - result/
    when: always
  timeout: 1h

