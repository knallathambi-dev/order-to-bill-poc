meta {
  name: getToken
  type: http
  seq: 2
}

post {
  url: {{keycloak_url}}/realms/SpringBootKeycloak/protocol/openid-connect/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: cpib
  password: {{catalog_client_secret}}
}

body:form-urlencoded {
  grant_type: client_credentials
}

script:post-response {
  bru.setEnvVar("catalog_token", res.body.access_token);
}
