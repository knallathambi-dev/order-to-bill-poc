meta {
  name: create Invalid new Product Relationship - modif - atomic without SP
  type: http
  seq: 7
}

post {
  url: {{dev_url}}/productInventoryManagement/v1/product
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  User-Agent: insomnia/2023.5.8
}

body:json {
  {
    "status": "Created",
    "operationalStatus": "Confirmed",
    "@type": "Product",
    "relatedParty": [
      {
        "id": "45hj-8888",
        "name": "Jean",
        "role": "Customer",
        "@referredType": "Individual"
      }
    ],
    "productPrice": [
      {
        "description": "POP_5Euro",
        "name": "POP_5Euro",
        "priceType": "NRC",
        "price": {
          "taxRate": 0,
          "dutyFreeAmount": {
            "unit": "EUR",
            "value": 5
          },
          "taxIncludedAmount": {
            "unit": "EUR",
            "value": 5
          }
        }
      }
    ],
    "productOffering": {
      "id": "8740a910-38d9-4c6d-8150-8f840c3c37ea",
      "name": "Time Bundle",
      "@type": "AtomicProductOffering"
    },
    "productOrderItem": [
      {
        "productOrderId": "{{productOrderID}}",
        "orderItemId": "05",
        "orderItemAction": "add"
      }
    ],
    "productRelationship": [
      {
        "relationshipType": "hasParent",
        "product": {
          "id": "655798d797c3752c61dfa0d2",
          "href": "/productInventoryManagement/v1/product/655798d797c3752c61dfa0d2",
          "@type": "ProductRef"
        },
        "@type": "ProductRelationShip"
      }
    ]
  }
}

script:pre-request {
  bru.setEnvVar("productOrderID", Math.floor((Math.random()*10000 +1)));
}
