meta {
  name: Create Physical Product -tangible- acquisition
  type: http
  seq: 2
}

post {
  url: {{base_url}}/productInventoryManagement/v1/product
  body: json
  auth: inherit
}

query {
  ~status: Created
  ~operationalStatus: Confirmed
}

headers {
  Content-Type: application/json
}

body:json {
