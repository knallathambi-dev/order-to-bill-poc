meta {
  name: Create tagible Product no contract
  type: http
  seq: 1
}

post {
  url: {{dev_url}}/productInventoryManagement/v1/product
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  User-Agent: insomnia/2023.5.8
}

body:json {
  {
      "status": "Created",
