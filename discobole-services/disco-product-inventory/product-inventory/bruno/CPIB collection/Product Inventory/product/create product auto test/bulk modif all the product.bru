script:pre-request {
  function getProductIDBy(productsInfo, productName, type) {
      productName = productName.toLowerCase(); 
      for (var i = 0; i < productsInfo.length; i++) {
          var currentProductName = productsInfo[i].name.toLowerCase();
          if (currentProductName === productName && productsInfo[i].type === type) {
              return productsInfo[i].id;
          }
      }
      return null;
  }
  
  var productsInfo = bru.getEnvVar("productsInfo");
  if (!productsInfo) {
      productsInfo = pm.globals.get("productsInfo");
  }
  productsInfo = JSON.parse(productsInfo);
  
  var simCardPSId= getProductIDBy(productsInfo, "SIM CARD", "productSpecification");
  var connectivityPSId= getProductIDBy(productsInfo, "Connectivity", "productSpecification");
  var mobileLinePSId= getProductIDBy(productsInfo, "MobileLine", "productSpecification");
  var timeBundlePSId= getProductIDBy(productsInfo, "Time Bundle", "productSpecification");
  
  var simCardAtomicPOId= getProductIDBy(productsInfo, "SIM CARD", "AtomicProductOffering");
  var connectivityAtomicPOId= getProductIDBy(productsInfo, "Connectivity", "AtomicProductOffering");
  var mobileLineAtomicPOId= getProductIDBy(productsInfo, "MobileLine", "AtomicProductOffering");
  var timeBundleAtomicPOId= getProductIDBy(productsInfo, "Time Bundle", "AtomicProductOffering");
  
  var MP1BundledPOId= getProductIDBy(productsInfo, "Mobile Package Basic", "BundleProductOffering");
  
  var MP1ContractId= getProductIDBy(productsInfo, "Mobile Package Basic", "Contract");
  
  console.log(MP1ContractId , MP1BundledPOId , timeBundleAtomicPOId, mobileLineAtomicPOId, connectivityAtomicPOId, simCardAtomicPOId, timeBundlePSId, mobileLinePSId, connectivityPSId, simCardPSId)
  
  bru.setEnvVar("simCardPSId", simCardPSId);
  bru.setEnvVar("connectivityPSId", connectivityPSId);
  bru.setEnvVar("mobileLinePSId", mobileLinePSId);
  bru.setEnvVar("timeBundlePSId", timeBundlePSId);
  
  
  bru.setEnvVar("simCardAtomicPOId", simCardAtomicPOId);
  bru.setEnvVar("connectivityAtomicPOId", connectivityAtomicPOId);
  bru.setEnvVar("mobileLineAtomicPOId", mobileLineAtomicPOId);
  bru.setEnvVar("timeBundleAtomicPOId", timeBundleAtomicPOId);
  
  bru.setEnvVar("MP1BundledPOId", MP1BundledPOId);
  
  bru.setEnvVar("MP1ContractId", MP1ContractId);
  
}
