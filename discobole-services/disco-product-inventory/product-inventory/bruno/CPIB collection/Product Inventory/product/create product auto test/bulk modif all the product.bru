meta {
  name: bulk modif all the product
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/productInventoryManagement/v1/product
  body: json
  auth: none
}

query {
  ~status: Created
  ~operationalStatus: Confirmed
}

headers {
  Content-Type: application/json-patch+json
}

body:json {
  [
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{MP1ContractId}}/status",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{MP1ContractId}}/operationalStatus",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{MP1BundledPOId}}/status",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{MP1BundledPOId}}/operationalStatus",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{timeBundleAtomicPOId}}/status",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{timeBundleAtomicPOId}}/operationalStatus",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{mobileLineAtomicPOId}}/status",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{mobileLineAtomicPOId}}/operationalStatus",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{connectivityAtomicPOId}}/status",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{connectivityAtomicPOId}}/operationalStatus",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{simCardAtomicPOId}}/status",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{simCardAtomicPOId}}/operationalStatus",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/{{timeBundlePSId}}/status",
          "value": "Active"
      },
      {
          "op": "replace",
