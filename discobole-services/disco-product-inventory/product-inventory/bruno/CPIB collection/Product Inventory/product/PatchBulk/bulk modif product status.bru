}

body:json {
  [
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/65afc08309023b1a9a95cbeb/status",
          "value": "Active"
      },
      {
          "op": "replace",
          "path": "/productInventoryManagement/v1/product/65afc08309023b1a9a95cbeb/operationalStatus",
