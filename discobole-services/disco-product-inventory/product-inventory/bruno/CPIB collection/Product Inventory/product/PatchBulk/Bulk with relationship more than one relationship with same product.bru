meta {
  name: Bulk with relationship more than one relationship with same product
  type: http
  seq: 10
}

patch {
  url: {{base_url}}/productInventoryManagement/v1/product
  body: json
  auth: none
}

query {
  ~status: Created
  ~operationalStatus: Confirmed
}

headers {
  Content-Type: application/json-patch+json
}

body:json {
  [
      {
          "op": "add",
          "path": "/productInventoryManagement/v1/product/651edc777411e974c97761b4/productRelationship/-",
          "value": {
              "relationshipType": "sells",
              "product": {
                  "id": "651edc777411e974c97761b2",
                  "@type": "ProductRef"
              }
          }
      },
      {
          "op": "add",
          "path": "/productInventoryManagement/v1/product/651edc777411e974c97761b4/productRelationship/-",
          "value": {
              "relationshipType": "ReliesOn",
              "product": {
                  "id": "651edc777411e974c97761b2",
                  "@type": "ProductRef"
              }
          }
      },
      {
          "op": "add",
          "path": "/productInventoryManagement/v1/product/651edc777411e974c97761b8/productRelationship/-",
          "value": {
              "relationshipType": "bundles",
              "product": {
                  "id": "651edc777411e974c97761b2",
                  "@type": "ProductRef"
              }
          }
      }
  ]
}
