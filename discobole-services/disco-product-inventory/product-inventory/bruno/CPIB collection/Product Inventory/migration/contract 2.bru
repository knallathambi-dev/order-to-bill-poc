script:post-response {
  var responseBody = res.body;
  
  var productsInfo = [];
  
  function extractProductInfo(products) {
      products.forEach(function(product) {
          if (product.productOffering || product.productSpecification) {
              var productInfo = {
                  id: product.id,
                  type: product.productOffering ? product.productOffering['@type'] : 'productSpecification',
                  name: product.productOffering ? product.productOffering.name : (product.productSpecification ? product.productSpecification.name : null)
              };
              productsInfo.push(productInfo);
          }
          if (product.productRelationship) {
              product.productRelationship.forEach(function(relationship) {
                  if (relationship.relationshipType !== "ParentContract") {
                      extractProductInfo([relationship.product]);
                  }
              });
          }
      });
  }
  
  extractProductInfo([responseBody]);
  console.log("productsInfo: ",productsInfo);
  
  bru.setEnvVar("newContractId", (productsInfo.find(item => item.type == "Contract") || {}).id);
  bru.setEnvVar("newBundleId", (productsInfo.find(item => item.type == "BundleProductOffering") || {}).id);
  bru.setEnvVar("newAtomicId", (productsInfo.find(item => item.type == "AtomicProductOffering") || {}).id);
  
  bru.setEnvVar("newAtomicId2", (productsInfo.find(item => item.type == "AtomicProductOffering" && item.id!=bru.getEnvVar("newAtomicId")) || {}).id);
  console.log("newContractId: ",bru.getEnvVar("newContractId"));
  console.log("newBundleId: ",bru.getEnvVar("newBundleId"));
  console.log("newAtomicId: ",bru.getEnvVar("newAtomicId"));
  console.log("newAtomicId2: ",bru.getEnvVar("newAtomicId2"));
  
}
