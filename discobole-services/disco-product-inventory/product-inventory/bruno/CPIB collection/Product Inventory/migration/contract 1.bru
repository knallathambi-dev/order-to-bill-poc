script:post-response {
  var responseBody = res.body;
  
  var productsInfo = [];
  var productsIds= [];
  
  function extractProductInfo(products) {
      products.forEach(function(product) {
          if (product.productOffering || product.productSpecification) {
              var productInfo = {
                  id: product.id,
                  type: product.productOffering ? product.productOffering['@type'] : 'productSpecification',
                  name: product.productOffering ? product.productOffering.name : (product.productSpecification ? product.productSpecification.name : null)
              };
              productsInfo.push(productInfo);
            productsIds.push(product.id);
          }
          if (product.productRelationship) {
              product.productRelationship.forEach(function(relationship) {
                  if (relationship.relationshipType !== "ParentContract") {
                      extractProductInfo([relationship.product]);
                  }
              });
          }
      });
  }
  
  extractProductInfo([responseBody]);
  bru.setEnvVar("oldContractId", (productsInfo.find(item => item.type == "Contract") || {}).id);
  bru.setEnvVar("oldBundleId", (productsInfo.find(item => item.type == "BundleProductOffering") || {}).id);
  bru.setEnvVar("oldAtomicId", (productsInfo.find(item => item.type == "AtomicProductOffering") || {}).id);
  let patchAtivationRequest="[";
  productsIds.forEach(id=>{patchAtivationRequest+=`
   {
      "op": "replace",
      "path": "/productInventoryManagement/v1/product/${id}/status",
      "value": "Active"
    },
    {
      "op": "replace",
      "path": "/productInventoryManagement/v1/product/${id}/operationalStatus",
      "value": "Active"
    },`})
  patchAtivationRequest = patchAtivationRequest.slice(0, -1); // Removes the last character
  
  patchAtivationRequest+="]";
  console.log("oldContractId: ",bru.getEnvVar("oldContractId"));
  console.log("oldBundleId: ",bru.getEnvVar("oldBundleId"));
  console.log("oldAtomicId: ",bru.getEnvVar("oldAtomicId"));
  bru.setEnvVar("patchAtivationRequest", patchAtivationRequest);
  console.log("patchAtivationRequest: ",bru.getEnvVar("patchAtivationRequest"));
  
}
