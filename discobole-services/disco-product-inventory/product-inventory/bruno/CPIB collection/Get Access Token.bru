meta {
  name: Get Access Token
  type: http
  seq: 1
}

post {
  url: {{keycloak_url}}/realms/SpringBootKeycloak/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{username}}
  password: {{password}}
  grant_type: password
  client_id: {{client_id}}
  client_secret: {{client_secret}}
  scope: openid
}

script:post-response {
  bru.setEnvVar("token", res.body.access_token);
}
