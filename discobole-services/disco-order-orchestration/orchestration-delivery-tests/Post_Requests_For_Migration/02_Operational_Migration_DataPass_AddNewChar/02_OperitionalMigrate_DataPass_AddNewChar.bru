script:pre-request {
  bru.setVar("Random_number", Math.random()*Math.random()*100000);
}

script:post-response {
  var jsonData = req.body ;
  
  //Get Order ID
  bru.setVar("order_id", jsonData.id);
   
  console.log("order_id:"+bru.getVar("order_id"));
}

docs {
  - this request for create plan with CFS product” DataPass “
  - OM body has two product order items and the  new product order item has relationship type” migratedTo “ with  the old product order item
  - the new product Characteristics has additional Characteristic as below 
  - the product Characteristics for old product order item 
                   { "name": "Volume", "value": "One hour"  },
                    { "name": "recurring", "value": "N" }
  - The product Characteristics for new product order item 
                
                    { "name": "Volume", "value": " One hour"  },
                     { "name": "recurring", "value": "N" }
                     { "name": "blocked", "value": "Y" }
  
}
