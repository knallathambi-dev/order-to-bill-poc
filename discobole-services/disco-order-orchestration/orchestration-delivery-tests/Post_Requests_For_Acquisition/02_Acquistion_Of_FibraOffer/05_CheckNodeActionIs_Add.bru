meta {
  name: 05_CheckNodeActionIs_Add
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/orchestrationPlan/{{plan_id}}
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

script:pre-request {
   
}

tests {
    test("Status code is 200", function () {
        expect(res.getStatus()).to.equal(200);
    });
    
    var jsonData = res.body; 
   test("Check TV channeles PS node action is add", function () { 
        expect(jsonData.orchestrationPlanNodes[0].relatedProductOrderItem[0].action).to.be.oneOf(["add"]);
        console.log("Orchestration Node action = " + jsonData.orchestrationPlanNodes[0].relatedProductOrderItem[0].action);
    });
    
    test("Check Internet Bos PS node action is add", function () { 
        expect(jsonData.orchestrationPlanNodes[1].relatedProductOrderItem[0].action).to.be.oneOf(["add"]);
        console.log("Orchestration Node action = " + jsonData.orchestrationPlanNodes[1].relatedProductOrderItem[0].action);
    });
  //check nod action for time Fibra 1000 PS 
    
    test("Check Fibra 1000 PS node action is add", function () { 
        expect(jsonData.orchestrationPlanNodes[2].relatedProductOrderItem[0].action).to.be.oneOf(["add"]);
        console.log("Orchestration Node action = " + jsonData.orchestrationPlanNodes[2].relatedProductOrderItem[0].action);
    });
  
  // check node action on fix communication PS
    test("Check fix communication PS node action is add", function () { 
        expect(jsonData.orchestrationPlanNodes[3].relatedProductOrderItem[0].action).to.be.oneOf(["add"]);
        console.log("Orchestration Node action = " + jsonData.orchestrationPlanNodes[3].relatedProductOrderItem[0].action);
    });
   
   // check node action on fix Add-on Netfilix PSS
    test("Check fix Add-on Netfilix PS node action is add", function () { 
        expect(jsonData.orchestrationPlanNodes[4].relatedProductOrderItem[0].action).to.be.oneOf(["add"]);
        console.log("Orchestration Node action = " + jsonData.orchestrationPlanNodes[4].relatedProductOrderItem[0].action);
    });
   // check node action on fix Add-on router PS 
    test("Check fix router PS node action is add", function () { 
        expect(jsonData.orchestrationPlanNodes[5].relatedProductOrderItem[0].action).to.be.oneOf(["add"]);
        console.log("Orchestration Node action = " + jsonData.orchestrationPlanNodes[5].relatedProductOrderItem[0].action);
    });
   // check node action on fix TV box PS 
    test("Check fix TV box PS node action is add", function () { 
        expect(jsonData.orchestrationPlanNodes[6].relatedProductOrderItem[0].action).to.be.oneOf(["add"]);
        console.log("Orchestration Node action = " + jsonData.orchestrationPlanNodes[6].relatedProductOrderItem[0].action);
    });
   // check node action on add-on HBO ps 
    test("Check fix add-on HBO ps node action is add", function () { 
        expect(jsonData.orchestrationPlanNodes[7].relatedProductOrderItem[0].action).to.be.oneOf(["add"]);
        console.log("Orchestration Node action = " + jsonData.orchestrationPlanNodes[7].relatedProductOrderItem[0].action);
    });
   
}

