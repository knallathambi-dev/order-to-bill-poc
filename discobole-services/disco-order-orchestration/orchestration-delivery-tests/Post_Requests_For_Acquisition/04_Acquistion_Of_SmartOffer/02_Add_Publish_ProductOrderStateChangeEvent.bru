  test("should plan created sucessfuly", function() {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  - this request for puplish plan has 4 products SIMCard, Conectivity , Mobile line and TimeBundel .
  - Mobile Line and Conectivity have relationship "reliesOn" SIM Card.
  - Time Bundel has relationship "reliesOn" Mobile Line
  
  
  
  
}
