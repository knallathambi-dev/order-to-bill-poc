assert {
  res.status: eq 200
}

script:pre-request {
  bru.setVar("Random_number", Math.random()*Math.random()*100000);
}

script:post-response {
  var jsonData = req.body ;
  
  //Get Order ID
  bru.setVar("order_id", jsonData.id);
   
  console.log("order_id:"+bru.getVar("order_id"));
}

tests {
  test("should plan created sucessfuly", function() {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  This request to create plan with two product items  
  "RingBackTone" has action add 
  and SMS option has action modify 
}
