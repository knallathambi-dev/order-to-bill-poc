<configuration>
    <appender name="JSONCONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.AccessEventCompositeJsonEncoder">
            <providers>
                <pattern>
                    <pattern>
                        {
                        "@timestamp": "%date{yyyy-MM-dd'T'HH:mm:ss.SSSZ,UTC}",
                        "@project": "delivery-management",
                        "service.name": "delivery-management",
                        "@type": "access",
                        "client.ip": "%remoteIP",
                        "client.user.name": "%user",
                        "http.request.method": "%requestMethod",
                        "http.version": "%protocol",
                        "http.request.uri": "%requestURI",
                        "http.response.status_code": "%statusCode",
                        "http.response.elapsed_time": "%elapsedTime",
                        "http.request.url": "%requestURL",
                        "http.request.referrer": "%header{Referer}",
                        "user_agent.name": "%header{User-agent}",
                        "host.name": "%header{Host}",
                        "http.request.accept": "%header{Accept}",
                        "http.request.accept_encoding": "%header{Accept-Encoding}",
                        "http.request.connection": "%header{Connection}",
                        "http.response.content_type": "%responseHeader{Content-Type}",
                        "http.response.content_length": "%bytesSent",
                        "http.response.server": "%server",
                        "http.response.connection": "%responseHeader{Connection}",
                        "http.request.session": "%sessionID",
                        "http.request.query_string":"%queryString"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <appender-ref ref="JSONCONSOLE" />

</configuration>