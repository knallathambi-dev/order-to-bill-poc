<FindBugsFilter>

    <Match>
        <!-- Exclude JPA Entity Meta Model -->
        <Class name="~.*_"/>
    </Match>

    <Match>
        <!-- Exclude generated files by OpenAPI generator -->
        <Package name="~.*dto.*"/>
    </Match>

    <Match>
        <!-- Exclude generated files by OpenAPI generator -->
        <Package name="~.*api.*"/>
    </Match>

    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Or>
            <Package name="~.*model.*"/>
            <Package name="~.*dto.*"/>
            <Package name="~.*exception.*"/>
        </Or>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Package name="~.*model.*"/>
            <Package name="~.*dto.*"/>
            <Package name="~.*exception.*"/>

        </Or>
    </Match>
    <Match>
        <!-- We have a lot of false positives for this pattern. -->
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
    <Match>
        <!-- We have a lot of false positives for this pattern. -->
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
    <Match>
        <Bug pattern="NP_BOOLEAN_RETURN_NULL"/>
    </Match>

</FindBugsFilter>