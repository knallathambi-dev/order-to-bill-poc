{
  "mappings": [
    {
      "name": "Get Products",
      "priority": 1,
      "request": {
        "urlPath": "/productInventoryManagement/v1/product",
        "method": "GET",
        "queryParameters": {
          "productOrderItem.productOrderId": {
            "matches": "1111.*"
          },
          "productOrderItem.orderItemId": {
            "matches": ".*"
          }
        }
      },
      "response": {
        "status": 200,
        "bodyFileName": "customer-product-installed-base/activeDeleteProduct/AllProducts.json",
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        }
      }
    },
