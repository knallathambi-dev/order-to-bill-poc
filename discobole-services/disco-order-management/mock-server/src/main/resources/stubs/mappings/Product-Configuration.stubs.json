{
  "mappings": [
    {
      "name": "Create configuration session on acquisition - Success",
      "priority": 1,
      "request": {
        "url": "/v1/QueryProductConfiguration",
        "method": "POST",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$.productOfferingId",
            "operator": "exists"
          },
          {
            "matchesJsonPath": {
              "expression": "$.process",
              "equalTo": "acquisition"
            }
          }
        ]
      },
      "response": {
        "status": 201,
        "bodyFileName": "Product-Configuration/ConfigurationCreatedAcquisition.json",
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        }
      }
    },
    {
      "name": "Create configuration session on modification - Success",
      "priority": 2,
      "request": {
        "url": "/v1/QueryProductConfiguration",
        "method": "POST",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$.productId",
