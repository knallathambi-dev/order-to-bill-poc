{
  "mappings": [
    {
      "name": "Get Appointment - Success",
      "priority": 1,
      "request": {
        "urlPattern": "/appointmentManagement/v4/appointment/14.*",
        "method": "GET"
      },
      "response": {
        "status": 200,
        "bodyFileName": "Appointment/Appointment.json",
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        }
      }
    },
    {
      "name": "Not found",
      "priority": 1,
      "request": {
        "urlPattern": "/appointmentManagement/v4/appointment/(?!14).*",
        "method": "GET"
      },
      "response": {
        "status": 404,
        "bodyFileName": "NotFound.json",
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        }
      }
    }
  ]
}