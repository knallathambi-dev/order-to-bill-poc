{
  "mappings": [
    {
      "name": "Updated Product Status: Created to Confirmed - Success",
      "priority": 1,
      "request": {
        "urlPath": "/productManagement/v1/product",
        "method": "PATCH",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$[0].value",
              "equalTo": "Created"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$[1].value",
              "equalTo": "Confirmed"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "Product-Management/ProductsConfirmed.json",
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        }
      }
    },
    {
