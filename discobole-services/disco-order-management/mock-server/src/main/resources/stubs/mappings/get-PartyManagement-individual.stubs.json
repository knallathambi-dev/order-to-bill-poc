{
  "mappings": [
    {
      "request": {
        "method": "GET",
        "urlPattern": "/partyManagement/v5/individual/.*"
      },
      "response": {
        "status": 200,
        "fixedDelayMilliseconds": 100,
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "bodyFileName": "Party-Management/individual.json",
        "transformers": [
          "response-template"
        ]
      }
    },
    {
      "name": "Get eligible party",
      "priority": 1,
      "request": {
        "urlPattern": "/partyManagement/v1/individual/(?!14).*",
        "method": "GET"
      },
      "response": {
        "status": 200,
        "bodyFileName": "Party-Management/EligibleIndividual.json",
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        }
      }
    },
    {
      "name": "Get not eligible party",
      "priority": 1,
      "request": {
        "urlPattern": "/partyManagement/v1/individual/14.*",
        "method": "GET"
      },
      "response": {
        "status": 200,
        "bodyFileName": "Party-Management/NotEligibleIndividual.json",
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        }
      }
    }
  ]
}
