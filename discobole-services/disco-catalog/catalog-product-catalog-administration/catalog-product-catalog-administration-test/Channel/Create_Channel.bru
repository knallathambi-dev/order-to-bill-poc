meta {
  name: Create_Channel
  type: http
  seq: 1
}

post {
  url: {{Admin_URL}}/channel
  body: json
  auth: none
}

body:json {
  
  
  {
    "id": "test{{random}}",
    "@type": "Channel",
    "@baseType": null,
    "schemaLocation": null,
    "href": null,
    "lastUpdate": "2025-01-20T15:30:45.123456",
    "name": "test{{random}}"
  }
}

vars:post-response {
  Channel_id: res.body.id
}

assert {
  res.status: eq 200
}

script:pre-request {
  var min = 1;
  var max = 100;
  var random = Math.floor(Math.random() * (max - min + 1)) + min;
  bru.setEnvVar("random", random); 
  
}
