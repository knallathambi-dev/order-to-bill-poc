meta {
  name: Create_Currency
  type: http
  seq: 4
}

post {
  url: {{Admin_URL}}/currency
  body: json
  auth: none
}

body:json {
  {
     
      "@type": "currency",
      "code":"INR",
      "label":"INR"
  }
}

vars:post-response {
  Currency_id: res.body.id
}

assert {
  res.status: eq 200
}
