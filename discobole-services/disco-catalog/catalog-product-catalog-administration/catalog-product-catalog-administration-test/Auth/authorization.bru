meta {
  name: authorization
  type: http
  seq: 1
}

post {
  url: {{Auth}}
  body: formUrlEncoded
  auth: none
}

headers {
  ~grant_type: password
  ~username: cs@orange.com
  ~password: 12345
}

body:form-urlencoded {
  username: {{User_id}}
  password: {{Password}}
  grant_type: password
  client_id: gateway
  client_secret: {{secret}}
  scope: openid
}

tests {
  var jsonData = res.getBody();
  bru.setEnvVar("token", jsonData.access_token);
  
  
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
