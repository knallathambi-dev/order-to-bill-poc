meta {
  name: Modify_Freqency
  type: http
  seq: 3
}

put {
  url: {{Admin_URL}}/frequencyTypes/{{Frequency_id}}
  body: json
  auth: none
}

body:json {
  {
    "@type":"frequencyTypes",
    "frequencyCode":"testMod{{random}}",
    "frequencyLabel":"testMod{{random}}"
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  var min = 1;
  var max = 100;
  var random = Math.floor(Math.random() * (max - min + 1)) + min;
  bru.setEnvVar("random", random); 
  
}
