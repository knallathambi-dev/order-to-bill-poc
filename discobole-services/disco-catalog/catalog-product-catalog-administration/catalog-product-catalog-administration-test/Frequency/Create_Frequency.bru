meta {
  name: Create_Frequency
  type: http
  seq: 1
}

post {
  url: {{Admin_URL}}/frequencyTypes
  body: json
  auth: none
}

body:json {
  {
    "@type":"frequencyTypes",
    "frequencyCode":"test{{random}}",
    "frequencyLabel":"test{{random}}"
  }
}

vars:post-response {
  Frequency_id: res.body.id
}

assert {
  res.status: eq 200
}

script:pre-request {
  var min = 1;
  var max = 100;
  var random = Math.floor(Math.random() * (max - min + 1)) + min;
  bru.setEnvVar("random", random); 
  
}
