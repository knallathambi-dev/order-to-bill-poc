meta {
  name: Modify_Unit
  type: http
  seq: 3
}

put {
  url: {{Admin_URL}}/unit/{{Unit_id}}
  body: json
  auth: none
}

body:json {
  {
    
      "@type": "unit",
  
    
      "unitOfMeasure": "unitMod_{{random}}"
  }
}

assert {
  res.body.unitOfMeasure: eq unitMod_{{random}}
  res.status: eq 200
}

script:pre-request {
  var min = 1;
  var max = 100;
  var random = Math.floor(Math.random() * (max - min + 1)) + min;
  bru.setEnvVar("random", random); 
  
}
