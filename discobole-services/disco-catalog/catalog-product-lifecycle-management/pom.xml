    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2022.0.3</spring-cloud.version>
        <processflow.version>3.0.1</processflow.version>
        <swagger.version>3.0.0</swagger.version>
        <cucumber.version>6.8.1</cucumber.version>
        <ssm.version>3.1.0</ssm.version>
        <sonar.qualitygate.wait>true</sonar.qualitygate.wait>
        <fluency.version>2.5.1</fluency.version>
        <fluentd.logger.version>0.3.4</fluentd.logger.version>
        <logback.version>1.4.11</logback.version>
        
        <spotbugs.skip>true</spotbugs.skip>
        <spotbugs.version>4.5.0</spotbugs.version>
        <spotbugs.exclude>${project.basedir}/src/main/resources/config/spotbugs-exclude.xml</spotbugs.exclude>
		<pmd.skip>true</pmd.skip>
		<pmd.rules>file:///${project.basedir}/src/main/resources/config/quality/pmd_orange.xml</pmd.rules>
		<pmd.allowedViolations>0</pmd.allowedViolations>
        <pmd.failurePriority>3</pmd.failurePriority>
        <checkstyle.skip>true</checkstyle.skip>
        <checkstyle.version>9.2.1</checkstyle.version>
        <checkstyle.rules>${project.basedir}/src/main/resources/config/quality/checkstyle_orange.xml</checkstyle.rules>
        <checkstyle.allowedViolations>0</checkstyle.allowedViolations>
        
    </properties>

