meta {
  name: defineidentitydata
  type: http
  seq: 3
}

patch {
  url: {{Next_task}}
  body: json
  auth: none
}

auth:basic {
  username: 
  password: 
}

auth:bearer {
  token: 
}

body:json {
  {
    "characteristic": [{
      "name": "defineIdentityData",
      "valueType": "Object",
      "value": {
        "identityData": {
          "name": "{{Entity_name}}",
          "description": "{{Entity_desc}}",
          "brand":"Orange",
          "productNumber":"10012"
        },
        "validityPeriod": {
          "validFor": {
            "startDateTime": "2025-04-12T23:20:50.520Z",
            "endDateTime": null
          }
        }
      },
      "@baseType": null,
      "@schemaLocation": null,
      "@type": "ObjectCharacteristic"
    }]
  }
}

vars:post-response {
  Next_task: res.body._links.nextTaskstoBePerformed[0].href
}

assert {
  res.status: eq 200
}

script:pre-request {
  const { v4: uuidv4 } = require('uuid');
  const inputName=uuidv4();
  let n = bru.getEnvVar("Entity_name");
  let d = bru.getEnvVar("Entity_desc");
  
  
  //check if name and desc is available in env else generate the same 
  if(n)
    {
      console.log("Entity_name is: "+n);
    }
  else{
    bru.setEnvVar("Entity_name", "Entity_test_"+inputName);
      console.log("inside else for name");// for logging
  }
  if(d)
    {
      console.log("Entity_name is: "+d);
    }
  else{
    bru.setEnvVar("Entity_desc", "Entity_desc_"+inputName);
      console.log("inside else for desc");
  }
}

tests {
  var jsonData = res.getBody();
  test("to verify Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  
  test("to verify Next task to be performed is defCharacteristics", function(){
      expect(jsonData._links.nextTaskstoBePerformed[0].title).to.eql("ProductSpecCreation.defCharacteristics");
  
  });
  
  
  test("to verify existingTaskEditable is having correct tasks", function(){
      expect(jsonData._links.existingTaskEditable[0].title).to.eql("ProductSpecCreation.defineIdentityData");
  });
  
  
}

docs {
  This step is defines the  Identitydata of the PS.
  it sends the entity name(variebles) and description in the payload if present in the environment else generates a random value.
}
