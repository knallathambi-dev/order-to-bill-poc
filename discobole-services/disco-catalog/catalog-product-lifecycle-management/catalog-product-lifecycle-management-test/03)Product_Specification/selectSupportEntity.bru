meta {
  name: selectSupportEntity
  type: http
  seq: 2
}

patch {
  url: {{Next_task}}
  body: json
  auth: none
}

auth:basic {
  username: 
  password: 
}

auth:bearer {
  token: 
}

body:json {
  {
        "characteristic": [
                      {
                          "name": "SelectSupportEntity",
                          "valueType": "Object",
                          "value":{
                              "supportEntitySpecification.id":"{{CFS_id}}",
                              "supportEntityType":"CFSSpec"
                          },
                          "@baseType": null,
                          "@schemaLocation": null,
                          "@type": "ObjectCharacteristic"
                      }
                  ]
  }
}

vars:post-response {
  PS_id: res.body.characteristic[1].value
  Next_task: res.body._links.nextTaskstoBePerformed[0].href
}

assert {
  res.status: eq 200
}

script:post-response {
  
  
}

tests {
  var jsonData = res.getBody();
  
  
  test("to verify Next task to be performed is defineIdentityData", function(){
      expect(jsonData._links.nextTaskstoBePerformed[0].title).to.eql("ProductSpecCreation.defineIdentityData");
  
  });
  
  
  test("to verify existingTaskEditable is blank", function(){
      expect(jsonData._links.existingTaskEditable.length).to.eql(0);
  });
  
  
  
  
}

docs {
  This step defines the SupportEntity of PS.
  the CFS_id is catered from the getCFS request 
  
}
