meta {
  name: get PO_active
  type: http
  seq: 14
}

get {
  url: {{host}}/productCatalogManagement/v1/productOffering?limit=20
  body: none
  auth: none
}

params:query {
  limit: 20
}

auth:basic {
  username: 
  password: 
}

auth:bearer {
  token: 
}

assert {
  res.status: eq 200
  ~res.body.id: eq {{APO_id}}
}

script:post-response {
  
  var jsonData = res.getBody();
  const activeItem = jsonData.find(item => item.lifecycleStatus === "launched");
  
    if (activeItem) {
      bru.setEnvVar("PO_active_id", activeItem.id); // Saves to environment variable
      console.log("Saved active_id:", activeItem.id);
    } else 
      {
      throw new Error(" No item with lifecycleStatus = 'launched' found.");
      }
  
}
