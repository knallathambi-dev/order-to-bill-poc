meta {
  name: DefineProductOfferingIdentityData
  type: http
  seq: 5
}

patch {
  url: {{Next_task}}
  body: json
  auth: none
}

auth:basic {
  username: 
  password: 
}

auth:bearer {
  token: 
}

body:json {
  {
      "characteristic": [
          {
              "name": "DefineProductOfferingIdentityData",
              "valueType": "Object",
              "value": {
                  "defineData": {
                      "name": "Po_{{Entity_name}}test",
                      "brand": "Orange",
                      "description": "Po_{{Entity_desc}}",
                      "isInstallable": true
                  },
                  "channels": [{
                          "channelId": "Web"
                      },
                      {
                          "channelId": "Shop"
                      },
                               {
                          "channelId": "Selfcare"
                      }
                    
                  ],
                  "marketSegments": [
                      {
                          "segmentId": "B2B"
                      }
                  ],
                  "relatedParties": [],
                  "poTerms":[],
                          
                  "validityPeriod": {
                      "validFor": {
                          "endDateTime": null,
                          "startDateTime": "2025-07-13T23:20:50.520Z"
                      }
                  }
              },
              "@baseType": null,
              "@schemaLocation": null,
              "@type": "ObjectCharacteristic"
          }
      ]
  }
}

vars:post-response {
  Next_task: res.body._links.nextTaskstoBePerformed[0].href
  Apo_name: res.body.name
}

assert {
  res.status: eq 200
}

script:pre-request {
  const { v4: uuidv4 } = require('uuid');
  const inputName=uuidv4();
  let n = bru.getEnvVar("Entity_name");
  let d = bru.getEnvVar("Entity_desc");
  
  
  //check if name and desc is available in env else generate a random 
  if(n)
    {
      console.log("Entity_name is: "+n);
    }
  else{
    bru.setEnvVar("Entity_name", "Entity_test_"+inputName);
      console.log("inside else for name");// for logging
  }
  if(d)
    {
      console.log("Entity_name is: "+d);
    }
  else{
    bru.setEnvVar("Entity_desc", "Entity_desc_"+inputName);
      console.log("inside else for desc");
  }
}

tests {
  var jsonData = res.getBody();
  
  
  test("To verify next task is define the Category", function () {
      expect(jsonData._links.nextTaskstoBePerformed[0].title).to.equals("ProductOfferingCreation.defCategory");
    });
}
