meta {
  name: CreateProcessFlow
  type: http
  seq: 1
}

post {
  url: {{host}}/po/processManagement/v1/processFlow
  body: json
  auth: none
}

headers {
  ~Cookie: 
}

auth:basic {
  username: 
  password: 
}

auth:bearer {
  token: 
}

body:json {
  {
      "processFlowSpecification": "ProductOfferingCreation"
  }
}

vars:post-response {
  Next_task: res.body._links.nextTaskstoBePerformed[0].href
}

assert {
  res.status: eq 201
}

tests {
  var jsonData =  res.body;
  
  
  
  test("To verify next task id offeringType", function () {
    expect(jsonData._links.nextTaskstoBePerformed[0].title).to.equals("ProductOfferingCreation.offeringType");
  });
  
  test("to verify canacel task is present", function () {
    expect(jsonData._links.nextTaskstoBePerformed[1].title).to.equals("ProductOfferingCreation.cancel");
  });
}
