							"\r",
							"});\r",
							"pm.test(\"to verify that supportEntityType.enum present in the response are  correct \", ()=>{\r",
							"    pm.expect(jsonData._links.nextTaskstoBePerformed[0].taskFlowSpecificationCharacteristic[0].characteristicValueSpecification[0].value.SelectSupportEntity.properties.supportEntityType.enum[1]).to.eql(\"StockItemType\");\r",
							"})\r",
							"\r",
							"pm.environment.set(\"SupportEntityValue\",jsonData._links.nextTaskstoBePerformed[0].taskFlowSpecificationCharacteristic[0].characteristicValueSpecification[0].value.SelectSupportEntity.properties.supportEntityType.enum[0]);\r",
							"\r",
							"pm.test(\"to verify ProductSpecCreation.cancel task is present\", function () {\r",
							"    //var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData._links.nextTaskstoBePerformed[1].title).to.eql(\"ProductSpecCreation.cancel\");\r",
							"});\r",
