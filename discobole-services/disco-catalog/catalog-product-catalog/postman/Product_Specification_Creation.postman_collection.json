							"resp[1] = jsonData._links.nextTaskstoBePerformed[0].taskFlowSpecificationCharacteristic[0].characteristicValueSpecification[0].value.SelectSupportEntity.required[1];\r",
							"\r",
							"pm.test(\"to verify Next task 'required' field is correct\", function () {\r",
