<included>
    <appender name="FLUENTD" class="ch.qos.logback.more.appenders.DataFluentAppender">
        <tag>${FLUENTD_TAG:-event-service}</tag>
        <label>application</label>
        <remoteHost>${FLUENTD_HOST:-localhost}</remoteHost>
        <port>${FLUENTD_PORT:-24224}</port>
        <maxQueueSize>20000</maxQueueSize>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"application":"event-service","environment":"openshift"}</customFields>
        </encoder>
    </appender>
    
    <root level="INFO">
        <appender-ref ref="FLUENTD"/>
    </root>
</included>
