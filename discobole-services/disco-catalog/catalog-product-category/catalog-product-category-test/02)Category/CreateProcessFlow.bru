meta {
  name: CreateProcessFlow
  type: http
  seq: 1
}

post {
  url: {{host}}/category/processManagement/v1/processFlow
  body: json
  auth: none
}

auth:basic {
  username: 
  password: 
}

auth:bearer {
  token: 
}

body:json {
  {
      "processFlowSpecification": "CategoryCreation"
  }
}

vars:post-response {
  Next_task: res.body._links.nextTaskstoBePerformed[1].href
}

assert {
  res.status: eq 201
}

tests {
  var jsonData = res.getBody();
  
  
  test("To verify that next task is selectEntityType ", function () {
    expect(jsonData._links.nextTaskstoBePerformed[1].title).to.equals("CategoryCreation.selectEntityType");
  });
  
  test("To verify that cancel task is present", function () {
    expect(jsonData._links.nextTaskstoBePerformed[0].title).to.equals("CategoryCreation.cancel");
  });
  
}
