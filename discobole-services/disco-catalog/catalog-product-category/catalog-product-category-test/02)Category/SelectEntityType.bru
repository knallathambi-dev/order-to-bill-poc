meta {
  name: SelectEntityType
  type: http
  seq: 2
}

patch {
  url: {{Next_task}}
  body: json
  auth: none
}

auth:basic {
  username: 
  password: 
}

auth:bearer {
  token: 
}

body:json {
  {
    "characteristic": [
      {
        "name": "SelectEntityType",
        "valueType": "Object",
        "value": {
          "categoryType": "ProductOfferingCategory"
        },
        "@baseType": null,
        "@schemaLocation": null,
        "@type": "ObjectCharacteristic"
      }
    ]
  }
}

vars:post-response {
  category_id: res.body.characteristic[1].value
  Next_task: res.body._links.nextTaskstoBePerformed[1].href
}

assert {
  res.status: eq 200
}

tests {
  var jsonData = res.getBody();
  
  
  
  test("to verify next task is defineCategoryIdentityData", function () {
    expect(jsonData._links.nextTaskstoBePerformed[1].title).to.equals("CategoryCreation.defineCategoryIdentityData");
  });
  
  
}
