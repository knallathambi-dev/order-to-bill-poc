}

body:json {
  {
      "characteristic": [
          {
              "name": "PolicyRuleAssociation",
              "valueType": "Object",
              "value": {
                 
              "associatePolicyRuleRefMinCardinality":1,
                  "associatePolicyRuleRef": [{
