meta {
  name: get PO
  type: http
  seq: 7
}

get {
  url: {{host}}/productCatalogManagement/v1/productOffering/{{APO_id}}
  body: none
  auth: none
}

auth:basic {
  username: 
  password: 
}

auth:bearer {
  token: 
}

assert {
  res.status: eq 200
  res.body.lifecycleStatus: eq active
}

script:pre-request {
  await bru.sleep(3000);
}

tests {
  var jsonData = res.getBody();
  
  
  test("To verify version is 0.2", function () {
    expect(jsonData.version).to.equals("0.2");
  });
  
  
  var jsonData = res.getBody();
  
  var cat_id=bru.getVar('category_id');
  var pop_id=bru.getVar('POPC_id');
  var rel_id=bru.getEnvVar('PO_active_id');
  var pol_id=bru.getVar('Policy_id');
  
  
  
  test("To verify channel is associated ", function () {
    expect(jsonData.channel[0].id).to.equals("Shop");
    expect(jsonData.channel[1].id).to.equals("Selfcare");
    expect(jsonData.channel[2].id).to.equals("Web");
  });
  
  
  test("To verify marketsegment is associated ", function () {
    expect(jsonData.marketSegment[0].id).to.equals("B2B");
    
  });
  
  test("To verify operation has POP associated to term ", function () {
    expect(jsonData.productOfferingTerm[0].commercialOperation[0].carries[0].id).to.equals(pop_id);
    
  });
  
  test("To verify relationship is associated ", function () {
    expect(jsonData.productOfferingRelationship[0].id).to.equals(rel_id);
    
  });
  
  test("To verify policyRule is associated ", function () {
    expect(jsonData.policyRuleRef[0].id).to.equals(pol_id);
  });
  
  
}
