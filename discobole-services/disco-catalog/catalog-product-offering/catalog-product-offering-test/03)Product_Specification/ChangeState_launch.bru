body:json {
  {
    "characteristic": [
      {
        "name": "DefineLifecycleState",
        "valueType": "Object",
        "value": {
          "state": "launched"
        },
        "@baseType": null,
        "@schemaLocation": null,
        "@type": "ObjectCharacteristic"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  await bru.sleep(3000);
}

tests {
  var jsonData = res.getBody();
  
  
  
  
  test("To verify nextTaskstoBePerformed/existingTaskEditable is empty", function () {
    expect(jsonData._links.nextTaskstoBePerformed.length).to.equals(0);
    expect(jsonData._links.existingTaskEditable.length).to.eql(0);  
  });
  
}

