meta {
  name: Event
  type: http
  seq: 4
}

post {
  url: {{host}}/policyRule/v1/event
  body: json
  auth: none
}

body:json {
  {
      "description": "Test_Event_{{random}}",
      "name": "Test_Event_{{random}}",
      "query": "(@.productConfiguration.productOffering.id=='{{APO_id}}')&&(@.action=='Add')",
      "event": []
  }
}

vars:post-response {
  event_id: res.body.id
}

assert {
  res.status: eq 201
}
