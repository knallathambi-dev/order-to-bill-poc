vars:post-response {
  CFS_id: res.body.event.id
}

assert {
  res.status: eq 202
}

script:pre-request {
  const { v4: uuidv4 } = require('uuid');
  const inputName=uuidv4();
  bru.setEnvVar("random", inputName);
  
}

docs {
  This request will create a CFS in the catalog  system.
  
  this CFS consist of 3 characterstics which are then passed in the PS creation process.
  
  Note:changes in CFS could lead to change in PS process scripts.
}
