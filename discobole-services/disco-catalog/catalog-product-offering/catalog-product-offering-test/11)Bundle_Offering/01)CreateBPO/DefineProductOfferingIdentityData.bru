}

vars:post-response {
  Next_task: res.body._links.nextTaskstoBePerformed[0].href
  BPO_name: res.body.name
}

assert {
  res.status: eq 200
}

tests {
  var jsonData = res.getBody();
  
  
  test("To verify next task is define the Category", function () {
      expect(jsonData._links.nextTaskstoBePerformed[0].title).to.equals("ProductOfferingCreation.defCategory");
    });
}
