// Setup:
//   cp env/env.local.example.js env.local.js
//   Fill in the values below
//   npm install && npm run dev
//
// Or use a predefined environment:
//   cp env/env.integration.js env.local.js

export const ENV_CONFIG = {
    GATEWAY_URL: "",
    CORPORATE_PROXY: "",

    FEATURE_ORDER_MANAGEMENT: "true",
    FEATURE_PRODUCT_INVENTORY: "false",
    FEATURE_ORDER_ORCHESTRATION: "false",

    ORDER_INVENTORY_UI_URL: "http://localhost:3001",
    PRODUCT_INVENTORY_UI_URL: "http://localhost:3003",
    ORDER_ORCHESTRATION_UI_URL: "http://localhost:3002",
};

if (typeof window !== "undefined") {
    window.__ENV__ = ENV_CONFIG;
}