# Order-to-Bill POC local defaults

POC_ENV=local
POC_HOST=localhost

# External Discobole monorepo used only as the Phase 2 copy source.
DISCOBOLE_SOURCE_MONOREPO=/Users/knallathambi/Engineering/projects/java-apps/discoble-monorepo
DISCOBOLE_SERVICES_DIR=discobole-services
DISCOBOLE_UI_DIR=discobole-ui

# Kafka must use KRaft mode only. Do not add ZooKeeper.
KAFKA_IMAGE=apache/kafka:4.3.0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
KAFKA_UI_PORT=8085
KAFKA_CONNECT_PORT=8083
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.0

# MongoDB local defaults.
MONGODB_IMAGE=mongo:7
MONGODB_PORT=27017
MONGODB_REPLICA_SET=rs0
MONGODB_DATABASE=otb_poc
MONGODB_USERNAME=otb
MONGODB_PASSWORD=otb-local-password

# Keycloak local defaults.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=discobole
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Gateway and UI ports.
POC_GATEWAY_PORT=8088
SELFCARE_UI_PORT=3000
ORDER_INVENTORY_UI_PORT=3001
ORDER_ORCHESTRATION_UI_PORT=3002

# Custom simulator service ports.
QUALIFICATION_SERVICE_PORT=18101
ACTIVATION_SERVICE_PORT=18102
BILLING_SERVICE_PORT=18103

# Discobole service URL placeholders for later phases.
ORDER_CAPTURE_URL=http://localhost:18080
ORDER_INVENTORY_URL=http://localhost:18081
ORCHESTRATION_DELIVERY_URL=http://localhost:18082
DELIVERY_MANAGEMENT_URL=http://localhost:18083
DELIVERY_FALLOUT_URL=http://localhost:18084
AUTH_USERROLE_URL=http://localhost:18085
PRODUCT_CATALOG_URL=http://localhost:18086

# Local-only secrets. Replace for any shared or non-local environment.
POC_GATEWAY_CLIENT_ID=poc-gateway
POC_GATEWAY_CLIENT_SECRET=change-me
SELFCARE_UI_CLIENT_ID=selfcare-ui
ADMIN_UI_CLIENT_ID=admin-ui
